; AETHRA: WILDBOUND
; Original voxel sandbox game foundation — Godot 4.7+
config_version=5

[application]
config/name="AETHRA: Wildbound"
config/description="Original multiplayer voxel survival sandbox"
config/icon="res://assets/icon.png"
config/version="0.2.3"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.025, 0.035, 0.07, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=1366
window/size/viewport_height=768
window/size/window_width_override=1366
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/size/resizable=true
window/size/min_width=1120
window/size/min_height=680
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

environment/defaults/default_clear_color=Color(0.055, 0.08, 0.12, 1)

[audio]
driver/enable_input=false

[physics]
3d/default_gravity=24.0

[network]
limits/debugger/max_chars_per_second=32768

[gui]
theme/default_font_multichannel_signed_distance_field=true

[autoload]
AppState="*res://scripts/core/app_state.gd"
Settings="*res://scripts/core/settings.gd"
SaveDB="*res://scripts/persistence/save_db.gd"
BlockRegistry="*res://scripts/data/block_registry.gd"
ItemRegistry="*res://scripts/data/item_registry.gd"
RecipeRegistry="*res://scripts/data/recipe_registry.gd"
NetworkManager="*res://scripts/network/network_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
ServerDirectory="*res://scripts/network/server_directory.gd"
